# Rellenar localmente. No son credenciales reales ni valores predeterminados.
DB_PASSWORD=
DB_USER=uvgo
DB_URL=jdbc:postgresql://localhost:5432/uvgo
SPRING_PROFILES_ACTIVE=dev
API_KEY_SERPAPI=
API_KEY_BRIGHTDATA=
# Generar al menos 32 bytes aleatorios y codificarlos en Base64 (openssl rand -base64 32).
JWT_SECRET=
INSTITUTIONAL_DOMAIN=uvg.edu.gt
# También rige el origen del WebSocket: agregar el del simulador (p. ej. http://localhost:3000), separado por comas.
CORS_ORIGINS=http://localhost:5173
# Clave con la que el simulador (Piloto Oscar) se conecta por WebSocket. Mínimo 16 caracteres (openssl rand -base64 24).
SIMULADOR_CLAVE=
# Extracción de productos desde PDF. ANTHROPIC_MODEL es opcional (claude-haiku-5-5 es el más barato).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
